# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/speedscore

# Session and JWT secrets (use long random values)
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret

# Token durations
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=7d

# OAuth (GitHub)
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret

# App URLs
API_DEPLOYMENT_URL=http://localhost:3000
CLIENT_DEPLOYMENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# Email (SendGrid)
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key
SENDGRID_FROM_ADDRESS=no-reply@example.com

# MFA encryption key (exactly 64 hex characters for 32 bytes)
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
